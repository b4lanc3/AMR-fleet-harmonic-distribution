<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>1.0.0</version>
  <description>Launch files, factory layout and parameters of the AMR fleet harmonic distribution simulation.</description>
  <maintainer email="tranbinhminh615@gmail.com">AMR Fleet Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_fleet_manager</exec_depend>
  <exec_depend>amr_fleet_msgs</exec_depend>
  <exec_depend>amr_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- Nav2 + AMCL per robot -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <!-- nav2_full_stack:=true -->
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

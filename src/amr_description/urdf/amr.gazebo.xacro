<?xml version="1.0"?>
<!-- Gazebo (Harmonic / Jetty) systems and sensors of the AMR.
     All topics are absolute and namespaced (/amr_01/...) so one ros_gz_bridge
     can serve the whole fleet. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="amr_gazebo" params="ns wheel_sep wheel_r camera camera_rate lidar_rate odom:=ground_truth camera_width:=320 camera_height:=240">
    <xacro:property name="wheel_odom" value="${odom == 'wheel'}"/>

    <gazebo>
      <!-- 2 driven wheels -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_sep}</wheel_separation>
        <wheel_radius>${wheel_r}</wheel_radius>
        <max_linear_velocity>2.0</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <max_linear_acceleration>1.6</max_linear_acceleration>
        <min_linear_acceleration>-2.0</min_linear_acceleration>
        <max_angular_acceleration>3.5</max_angular_acceleration>
        <min_angular_acceleration>-3.5</min_angular_acceleration>
        <topic>/${ns}/cmd_vel</topic>
        <xacro:if value="${wheel_odom}">
          <!-- wheel odometry: drifts like on a real AMR, AMCL publishes map->odom -->
          <odom_topic>/${ns}/odom</odom_topic>
          <tf_topic>/${ns}/tf</tf_topic>
        </xacro:if>
        <xacro:unless value="${wheel_odom}">
          <odom_topic>/${ns}/wheel_odom</odom_topic>
          <tf_topic>/${ns}/wheel_tf</tf_topic>
        </xacro:unless>
        <frame_id>${ns}/odom</frame_id>
        <child_frame_id>${ns}/base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <!-- exact pose: odometry in ground-truth mode, /<ns>/ground_truth otherwise -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>${ns}/odom</odom_frame>
        <robot_base_frame>${ns}/base_footprint</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <xacro:if value="${wheel_odom}">
          <odom_topic>/${ns}/ground_truth</odom_topic>
          <tf_topic>/${ns}/ground_truth_tf</tf_topic>
        </xacro:if>
        <xacro:unless value="${wheel_odom}">
          <odom_topic>/${ns}/odom</odom_topic>
          <tf_topic>/${ns}/tf</tf_topic>
        </xacro:unless>
        <dimensions>2</dimensions>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/${ns}/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <joint_name>cargo_joint</joint_name>
      </plugin>
      <!-- cargo lift: -0.30 = no load (below the floor), 0.235 = load on the deck.
           Force PID (velocity commands do not move a prismatic joint in gz-sim 8). -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>cargo_joint</joint_name>
        <topic>/${ns}/cargo_lift</topic>
        <initial_position>-0.30</initial_position>
        <p_gain>400</p_gain>
        <i_gain>40</i_gain>
        <d_gain>40</d_gain>
        <i_max>50</i_max>
        <i_min>-50</i_min>
        <cmd_max>150</cmd_max>
        <cmd_min>-150</cmd_min>
      </plugin>
    </gazebo>

    <!-- 2D lidar: 270 deg (+-135 deg) at the front of the robot, 0.5 deg resolution -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${lidar_rate}</update_rate>
        <topic>/${ns}/scan</topic>
        <gz_frame_id>${ns}/lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>541</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <xacro:if value="${camera}">
      <!-- RGB-D (3D) camera: image, depth_image, points, camera_info -->
      <gazebo reference="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>${camera_rate}</update_rate>
          <topic>/${ns}/camera</topic>
          <gz_frame_id>${ns}/camera_link</gz_frame_id>
          <camera name="rgbd">
            <horizontal_fov>1.50</horizontal_fov>
            <image>
              <width>${camera_width}</width>
              <height>${camera_height}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.15</near>
              <far>12.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.15</near>
                <far>8.0</far>
              </clip>
            </depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>

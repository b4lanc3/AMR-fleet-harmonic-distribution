<?xml version="1.0"?>
<!--
  Factory AMR: differential drive with 2 driven wheels (centre of the chassis)
  and 4 free (caster) wheels at the corners, one 2D lidar at the front and one
  RGB-D (3D) camera.  Footprint 0.80 m x 0.56 m, payload deck at 0.29 m.

  xacro args
    robot_name   namespace / frame prefix, e.g. amr_01   (frames: amr_01/base_link ...)
    color        r g b a of the body (unique colour per robot)
    gazebo       true -> add Gazebo Harmonic/Jetty systems and sensors
    camera       true -> add the RGB-D camera sensor
    camera_rate  RGB-D update rate [Hz]
    lidar_rate   lidar update rate [Hz]
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">
  <xacro:arg name="robot_name" default="amr_01"/>
  <xacro:arg name="color" default="0.16 0.47 0.84 1"/>
  <xacro:arg name="gazebo" default="true"/>
  <xacro:arg name="camera" default="true"/>
  <xacro:arg name="camera_rate" default="5"/>
  <xacro:arg name="lidar_rate" default="10"/>

  <xacro:property name="ns" value="$(arg robot_name)"/>
  <xacro:property name="pfx" value=""/>  <!-- frames are prefixed by robot_state_publisher (frame_prefix) -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- dimensions -->
  <xacro:property name="body_l" value="0.80"/>
  <xacro:property name="body_w" value="0.46"/>
  <xacro:property name="body_h" value="0.22"/>
  <xacro:property name="clearance" value="0.05"/>
  <xacro:property name="wheel_r" value="0.08"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="wheel_sep" value="0.52"/>
  <xacro:property name="caster_r" value="0.035"/>
  <xacro:property name="caster_x" value="0.30"/>
  <xacro:property name="caster_y" value="0.17"/>
  <xacro:property name="mass_body" value="45.0"/>

  <material name="body"><color rgba="$(arg color)"/></material>
  <material name="deck"><color rgba="0.20 0.21 0.23 1"/></material>
  <material name="rubber"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="metal"><color rgba="0.65 0.66 0.68 1"/></material>
  <material name="sensor"><color rgba="0.10 0.10 0.12 1"/></material>
  <material name="lamp"><color rgba="1.0 0.75 0.10 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="cyl_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>

  <!-- ============================================================ chassis -->
  <link name="${pfx}base_footprint"/>

  <link name="${pfx}base_link">
    <visual>
      <origin xyz="0 0 ${clearance + body_h/2 - wheel_r}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <!-- payload deck (covers the wheels) -->
      <origin xyz="0 0 ${clearance + body_h + 0.01 - wheel_r}"/>
      <geometry><box size="${body_l - 0.02} 0.56 0.02"/></geometry>
      <material name="deck"/>
    </visual>
    <visual>
      <!-- front bumper -->
      <origin xyz="${body_l/2 - 0.005} 0 ${clearance + 0.04 - wheel_r}"/>
      <geometry><box size="0.03 ${body_w + 0.04} 0.06"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <!-- status lamp -->
      <origin xyz="${-body_l/2 + 0.06} 0 ${clearance + body_h + 0.04 - wheel_r}"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="lamp"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${clearance + body_h/2 - wheel_r}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${clearance + body_h/2 - wheel_r}"/>
      <mass value="${mass_body}"/>
      <xacro:box_inertia m="${mass_body}" x="${body_l}" y="${body_w}" z="${body_h}"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="${pfx}base_footprint"/>
    <child link="${pfx}base_link"/>
    <origin xyz="0 0 ${wheel_r}"/>
  </joint>

  <!-- ======================================================= drive wheels -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${pfx}${side}_wheel_link">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="rubber"/>
      </visual>
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r*0.45}" length="${wheel_w + 0.004}"/></geometry>
        <material name="metal"/>
      </visual>
      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <xacro:cyl_inertia m="1.5" r="${wheel_r}" h="${wheel_w}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="${pfx}base_link"/>
      <child link="${pfx}${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="${pfx}${side}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1e6</kp>
      <kd>100</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_sep/2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_sep/2}"/>

  <!-- ===================================================== 4 free casters -->
  <xacro:macro name="caster" params="name x y">
    <link name="${pfx}caster_${name}_link">
      <visual>
        <!-- swivel housing -->
        <origin xyz="0 0 ${caster_r + 0.012}"/>
        <geometry><cylinder radius="0.03" length="0.025"/></geometry>
        <material name="metal"/>
      </visual>
      <visual>
        <geometry><sphere radius="${caster_r}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_r}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="1.5e-4" ixy="0" ixz="0" iyy="1.5e-4" iyz="0" izz="1.5e-4"/>
      </inertial>
    </link>
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="${pfx}base_link"/>
      <child link="${pfx}caster_${name}_link"/>
      <origin xyz="${x} ${y} ${caster_r - wheel_r}"/>
    </joint>
    <gazebo reference="${pfx}caster_${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1e6</kp>
      <kd>100</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front_left" x="${caster_x}" y="${caster_y}"/>
  <xacro:caster name="front_right" x="${caster_x}" y="${-caster_y}"/>
  <xacro:caster name="rear_left" x="${-caster_x}" y="${caster_y}"/>
  <xacro:caster name="rear_right" x="${-caster_x}" y="${-caster_y}"/>

  <!-- ========================================================== 2D lidar -->
  <link name="${pfx}lidar_link">
    <visual>
      <geometry><cylinder radius="0.038" length="0.05"/></geometry>
      <material name="sensor"/>
    </visual>
    <visual>
      <origin xyz="-0.02 0 -0.03"/>
      <geometry><box size="0.05 0.08 0.012"/></geometry>
      <material name="metal"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="${pfx}base_link"/>
    <child link="${pfx}lidar_link"/>
    <!-- front centre, 0.20 m above the floor, in front of the bumper -->
    <origin xyz="0.43 0 ${0.20 - wheel_r}"/>
  </joint>

  <!-- ===================================================== RGB-D camera -->
  <link name="${pfx}camera_link">
    <visual>
      <geometry><box size="0.03 0.12 0.03"/></geometry>
      <material name="sensor"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="${pfx}base_link"/>
    <child link="${pfx}camera_link"/>
    <origin xyz="0.40 0 ${0.31 - wheel_r}" rpy="0 0.12 0"/>
  </joint>
  <link name="${pfx}camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="${pfx}camera_link"/>
    <child link="${pfx}camera_optical_frame"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find amr_description)/urdf/amr.gazebo.xacro"/>
    <xacro:amr_gazebo ns="${ns}" wheel_sep="${wheel_sep}" wheel_r="${wheel_r}"
                      camera="$(arg camera)" camera_rate="$(arg camera_rate)"
                      lidar_rate="$(arg lidar_rate)"/>
  </xacro:if>
</robot>

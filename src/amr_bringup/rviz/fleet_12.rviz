Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: false
    Cell Size: 5
    Plane Cell Count: 24
    Offset:
      X: 50.0
      Y: 30.0
      Z: 0
  - Class: rviz_default_plugins/Map
    Name: Factory map
    Enabled: true
    Alpha: 0.35
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
  - Class: rviz_default_plugins/MarkerArray
    Name: Factory layout & traffic graph
    Enabled: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet/static_markers
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Fleet: labels, routes, reservations'
    Enabled: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet/markers
  - Class: rviz_common/Group
    Name: Robots
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: amr_01
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amr_01/robot_description
      TF Prefix: amr_01
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
